# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# NestJS Observe (https://observe.nestjs.com)
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
OBSERVE_SERVICE_ID="nexora-api"
OBSERVE_SERVICE_VERSION="0.0.1"
# Realtime configuration
REALTIME_DRIVER="socketio" # 'socketio' (local) or 'pusher' (production / vercel)
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_URL="redis://localhost:6379"

# Pusher Channels (Used when REALTIME_DRIVER=pusher)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"
PUSHER_USE_TLS="true"
